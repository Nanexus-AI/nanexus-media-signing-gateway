# Explicit isolated source roots. No network or implicit acquisition.
set(NANEXUS_DEPS "" CACHE PATH "Prepared dependency source directory")
set(ONVIF_PREFIX "" CACHE PATH "Pinned unthreaded official ONVIF installation")
if(NOT IS_DIRECTORY "${NANEXUS_DEPS}/ZLMediaKit" OR NOT IS_DIRECTORY "${ONVIF_PREFIX}/include/media-signing-framework")
  message(FATAL_ERROR "Prepare pinned dependencies and set NANEXUS_DEPS and ONVIF_PREFIX")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/scripts/prepare-m2-dependencies.py"
  --verify --dest "${NANEXUS_DEPS}" RESULT_VARIABLE pins OUTPUT_VARIABLE manifest)
if(NOT pins EQUAL 0)
  message(FATAL_ERROR "Dependency revision or patch verification failed")
endif()
file(WRITE "${CMAKE_BINARY_DIR}/dependency-manifest.json" "${manifest}")
foreach(opt API CXX_API PLAYER SERVER TESTS WEBRTC SRT SCTP HLS RTPPROXY FFMPEG X264 FAAC MYSQL PYTHON VIDEOSTACK OBJCOPY)
  set(ENABLE_${opt} OFF CACHE BOOL "Minimal native Gateway closure" FORCE)
endforeach()
set(ENABLE_MP4 ON CACHE BOOL "Pinned bundled codec-helper closure" FORCE)
set(ENABLE_OPENSSL ON CACHE BOOL "RTSP authentication and signing crypto" FORCE)
set(DISABLE_REPORT ON CACHE BOOL "Disable upstream reporting" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "Local static ZLM closure" FORCE)
add_subdirectory("${NANEXUS_DEPS}/ZLMediaKit" "${CMAKE_BINARY_DIR}/upstream")
find_package(OpenSSL 3 REQUIRED)
find_package(Threads REQUIRED)
find_library(ONVIF_LIBRARY NAMES media-signing-framework PATHS "${ONVIF_PREFIX}/lib" NO_DEFAULT_PATH REQUIRED)
add_library(gateway_media src/signer.cpp src/publisher.cpp src/runtime.cpp)
target_include_directories(gateway_media PUBLIC include "${ONVIF_PREFIX}/include/media-signing-framework"
  "${NANEXUS_DEPS}/ZLMediaKit" "${NANEXUS_DEPS}/ZLMediaKit/src"
  "${NANEXUS_DEPS}/ZLMediaKit/3rdpart/ZLToolKit/src" "${NANEXUS_DEPS}/ZLMediaKit/3rdpart"
  "${NANEXUS_DEPS}/ZLMediaKit/3rdpart/media-server/libmov/include"
  "${NANEXUS_DEPS}/ZLMediaKit/3rdpart/media-server/libflv/include")
target_compile_definitions(gateway_media PUBLIC ENABLE_MP4 ENABLE_OPENSSL DISABLE_REPORT ENABLE_VERSION)
target_compile_options(gateway_media PRIVATE -Wall -Wextra -Wno-unused-parameter)
target_link_libraries(gateway_media PUBLIC gateway_core "-Wl,--start-group" ext-codec zlmediakit ZLToolKit jsoncpp flv mov "-Wl,--end-group" "${ONVIF_LIBRARY}" OpenSSL::SSL OpenSSL::Crypto Threads::Threads)
target_link_libraries(nanexus-gateway PRIVATE gateway_media)
target_compile_definitions(nanexus-gateway PRIVATE NANEXUS_NATIVE)
if(BUILD_TESTING)
  add_executable(native-media-tests tests/native_media.cpp)
  target_link_libraries(native-media-tests PRIVATE gateway_media)
  add_test(NAME native-media COMMAND native-media-tests)
endif()
