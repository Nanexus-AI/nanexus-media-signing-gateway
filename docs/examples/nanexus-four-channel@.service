[Unit]
Description=Nanexus signing Gateway channel %i
RequiresMountsFor=/usr/local/nanexus/four-channel
After=network.target
PartOf=nanexus-four-channel.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
UMask=0077
WorkingDirectory=/usr/local/nanexus/four-channel
ExecStart=/usr/local/nanexus/four-channel/bin/nanexus-gateway --config /usr/local/nanexus/four-channel/config/gateway.conf --channel %i
Restart=on-failure
RestartSec=5
MemoryAccounting=yes
MemoryMax=128M
CPUAccounting=yes
CPUQuota=40%
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=nanexus-four-channel.target
