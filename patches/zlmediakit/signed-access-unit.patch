+bool H264RtpEncoder::inputSignedAccessUnit(const std::vector<Frame::Ptr> &nals, bool random_access) {
+    if (nals.empty() || nals.size() > 4096 || _last_frame || _sps || _pps) {
+        return false;
+    }
+    size_t total = 0;
+    const auto pts = nals.front() ? nals.front()->pts() : 0;
+    for (const auto &nal : nals) {
+        if (!nal || nal->getCodecId() != CodecH264 || nal->prefixSize() >= nal->size()
+            || nal->pts() != pts || nal->size() > 8 * 1024 * 1024 - total) {
+            return false;
+        }
+        total += nal->size();
+    }
+    for (size_t i = 0; i < nals.size(); ++i) {
+        const auto &nal = nals[i];
+        packRtp(nal->data() + nal->prefixSize(), nal->size() - nal->prefixSize(),
+                pts, i + 1 == nals.size(), random_access && i == 0);
+    }
+    return true;
+}
